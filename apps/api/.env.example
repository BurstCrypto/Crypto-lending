PORT=3001
API_HOST=127.0.0.1
# KAN-253 owns a separately orchestrated, loopback-only demo environment. Keep
# this disabled in ordinary development; `npm run demo:local` supplies the
# ephemeral values in memory and rejects production or non-loopback use.
LOCAL_DEMO_MODE=disabled
APPLICATION_WORKLOAD=api
API_DOCS_ENABLED=true
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=1000

AUTH_MODE=disabled
WALLET_REGISTRATION_MODE=disabled

# Managed authentication remains disabled unless the complete contract below
# is supplied from an approved deployment. The selected production target is a
# public Amazon Cognito User Pool client using authorization code + PKCE S256.
# Do not uncomment placeholders or store key material in this file.
# AUTH_MODE=oidc
# OIDC_PROVIDER_KEY=cognito
# OIDC_ISSUER_URL=https://cognito-idp.<aws-region>.amazonaws.com/<user-pool-id>
# OIDC_AUTHORIZATION_ENDPOINT=https://<managed-login-domain>/oauth2/authorize
# OIDC_TOKEN_ENDPOINT=https://<managed-login-domain>/oauth2/token
# OIDC_JWKS_URI=https://cognito-idp.<aws-region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json
# OIDC_CLIENT_ID=<public-app-client-id>
# OIDC_AUDIENCE=<public-app-client-id>
# OIDC_REQUIRED_TOKEN_USE=id
# OIDC_END_SESSION_ENDPOINT=https://<managed-login-domain>/logout
# OIDC_POST_LOGOUT_REDIRECT_URI=https://<application-hostname>/login
# OIDC_SIGNING_ALGORITHM=RS256
# OIDC_TOKEN_AUTH_METHOD=none
# AUTH_PUBLIC_ORIGIN=https://<application-hostname>
# OIDC_REDIRECT_URI=https://<application-hostname>/api/v1/auth/callback
# OIDC_HTTP_TIMEOUT_MS=5000
# OIDC_TOKEN_RESPONSE_MAX_BYTES=16384
# OIDC_JWKS_RESPONSE_MAX_BYTES=65536
# OIDC_JWKS_CACHE_TTL_SECONDS=300
# OIDC_CLOCK_TOLERANCE_SECONDS=30
# OIDC_MAX_ID_TOKEN_AGE_SECONDS=600
# AUTH_PREAUTH_TTL_SECONDS=600
# AUTH_SESSION_IDLE_TTL_SECONDS=3600
# AUTH_SESSION_ABSOLUTE_TTL_SECONDS=86400
# AUTH_PREAUTH_SEAL_KEY_ID=<stable-key-id>
# AUTH_PREAUTH_SEAL_KEY=<secret-manager-base64url-key>
# Production requires one canonical single-line JSON ring per HMAC purpose.
# Keys are sorted by numeric version, activeWriteVersion selects one listed key,
# and each key ID/material value is unique across every authentication purpose.
# AUTH_IDENTITY_HMAC_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"identity_v1","purpose":"identity-hmac","version":1,"material":"<secret-manager-base64url-key>"}]}
# AUTH_SESSION_HMAC_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"session_v1","purpose":"session-hmac","version":1,"material":"<secret-manager-base64url-key>"}]}
# AUTH_CSRF_HMAC_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"csrf_v1","purpose":"csrf-hmac","version":1,"material":"<secret-manager-base64url-key>"}]}
# Legacy single-key HMAC ID/material pairs are intentionally omitted. Production
# requires the ring fields above and rejects legacy or mixed-mode bindings.
# AUTH_CLIENT_ADDRESS_MODE=trusted-single-proxy
# AUTH_TRUSTED_PROXY_CIDRS=<exact-reviewed-alb-peer-cidr>

# Wallet ownership is a separate proof and never authorizes a transaction.
# Enable only with managed OIDC and independently managed key material.
# WALLET_REGISTRATION_MODE=enabled
# WALLET_REGISTRATION_REGISTRY_ENVIRONMENT=MAINNET
# WALLET_REGISTRATION_CHALLENGE_TTL_SECONDS=180
# Production uses one canonical compact JSON ring per wallet purpose. Each ring
# contains 1-3 version-sorted entries and selects one listed active write version.
# Legacy *_KEY_VERSION / *_KEY pairs are intentionally omitted and must not be
# configured together with these ring fields.
# WALLET_IDENTITY_HMAC_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"wallet-identity-v1","purpose":"identity-hmac","version":1,"material":"<secret-manager-base64url-key>"}]}
# WALLET_CHALLENGE_HMAC_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"wallet-challenge-v1","purpose":"challenge-hmac","version":1,"material":"<secret-manager-base64url-key>"}]}
# WALLET_METADATA_SEAL_KEY_RING_JSON={"activeWriteVersion":1,"keys":[{"keyId":"wallet-metadata-v1","purpose":"metadata-seal","version":1,"material":"<secret-manager-base64url-key>"}]}

# Read-only Aave/aggregate market and cross-chain route evidence is off by default.
# Enabling it requires the reviewed approval bindings and explicit per-source
# kill-switch decisions documented in docs/smart-lending-allocation-policy.md.
# Production currently rejects enabled mode until a verified activation manifest exists.
SMART_LENDING_EXTERNAL_FEEDS_MODE=disabled

DATABASE_RUNTIME_URL=postgres://crypto_api_login_a:local_api_database_a@localhost:5432/crypto_lending
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_MAX_LIFETIME_SECONDS=1800
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_RUNTIME_SSL_MODE=disable

MIGRATION_DATABASE_URL=postgres://crypto_migration:local_migration_only@localhost:5432/crypto_lending
MIGRATION_DATABASE_CONNECTION_TIMEOUT_MS=5000
MIGRATION_DATABASE_IDLE_TIMEOUT_MS=30000
MIGRATION_DATABASE_LOCK_TIMEOUT_MS=10000
MIGRATION_DATABASE_MAX_LIFETIME_SECONDS=1800
MIGRATION_DATABASE_STATEMENT_TIMEOUT_MS=3600000
MIGRATION_DATABASE_SSL_MODE=disable

# Local integration administration only; never use this identity in API,
# worker, or migration processes.
TEST_DATABASE_URL=postgres://crypto_admin:local_admin_only@localhost:5432/crypto_lending

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USERNAME=crypto_api_a
REDIS_PASSWORD=local-api-current
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/crypto-lending-jobs
SQS_DEAD_LETTER_QUEUE_URL=http://localhost:4566/000000000000/crypto-lending-jobs-dlq
SQS_BALANCE_QUEUE_URL=http://localhost:4566/000000000000/crypto-lending-balance-sync
SQS_BALANCE_DEAD_LETTER_QUEUE_URL=http://localhost:4566/000000000000/crypto-lending-balance-sync-dlq
SQS_REQUEST_TIMEOUT_MS=15000
SQS_SDK_MAX_ATTEMPTS=3
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_RETRY_BASE_DELAY_SECONDS=1
SQS_RETRY_MAX_DELAY_SECONDS=60

OUTBOX_BATCH_SIZE=25
OUTBOX_CLEANUP_BATCH_SIZE=100
OUTBOX_CLEANUP_INTERVAL_MS=60000
OUTBOX_CONCURRENCY=5
OUTBOX_FAILED_RETENTION_MS=2592000000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_PUBLISH_TIMEOUT_MS=10000
OUTBOX_PUBLISHED_RETENTION_MS=604800000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000

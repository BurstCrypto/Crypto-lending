APP_VERSION=0.1.0
APP_ENV=local

# Server-only opt-in for running the web and API development processes
# separately. The enabled origin is intentionally pinned to loopback.
WEB_API_PROXY_MODE=disabled
# WEB_API_PROXY_ORIGIN=http://127.0.0.1:3001

# Exact browser origin for authentication redirects. HTTPS is required outside
# development/test loopback environments; do not add a trailing slash or path.
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000

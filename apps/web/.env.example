APP_VERSION=0.1.0
APP_ENV=local

# Exact browser origin for authentication redirects. HTTPS is required outside
# development/test loopback environments; do not add a trailing slash or path.
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Restricted wallet validation lab. Leave disabled unless running the KAN-224
# testnet-only lab. Never use production credentials or expose this route publicly.
WALLET_LAB_ENABLED=false
WALLET_LAB_ENVIRONMENT=local
WALLET_LAB_BASIC_AUTH_USERNAME=
WALLET_LAB_BASIC_AUTH_PASSWORD=

{
  "name": "crypto-lending",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.4",
  "description": "Multi-wallet crypto lending platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @crypto-lending/web",
    "dev:local-demo:idp": "node tools/local-demo/identity-provider.mjs",
    "demo:local:preflight": "tsx tools/local-demo/configuration-preflight.ts",
    "demo:local": "node tools/local-demo/start.mjs",
    "demo:local:teardown": "node tools/local-demo/teardown.mjs",
    "local-evm:start": "node tools/local-evm/start.mjs",
    "local-evm:reset": "node tools/local-evm/reset.mjs",
    "local-evm:set-balance": "node tools/local-evm/set-balance.mjs",
    "local-evm:teardown": "node tools/local-evm/teardown.mjs",
    "testnet:live:preflight": "tsx tools/public-testnet/cli.ts --preflight",
    "testnet:live:smoke": "tsx tools/public-testnet/cli.ts --live",
    "test:testnet:live": "tsx --test tools/public-testnet/*.test.ts",
    "dev:wallet-lab": "npm --prefix tools/wallet-lab run dev",
    "lint:wallet-lab": "npm --prefix tools/wallet-lab run lint",
    "typecheck:wallet-lab": "npm --prefix tools/wallet-lab run typecheck",
    "test:wallet-lab": "npm --prefix tools/wallet-lab run test",
    "dev:api": "npm run start:dev --workspace @crypto-lending/api",
    "worker:outbox": "npm run worker:outbox --workspace @crypto-lending/api",
    "worker:outbox:prod": "npm run worker:outbox:prod --workspace @crypto-lending/api",
    "worker:balance": "npm run worker:balance --workspace @crypto-lending/api",
    "worker:balance:prod": "npm run worker:balance:prod --workspace @crypto-lending/api",
    "outbox:preflight:envelope": "tsx scripts/job-envelope-rollout-preflight.ts",
    "release:manifest": "node scripts/release-candidate-manifest.mjs",
    "lint:release": "eslint scripts/release-candidate-manifest.mjs scripts/release-candidate-manifest.test.mjs --config scripts/eslint.config.mjs --global Buffer --global process --global TextDecoder --global structuredClone",
    "test:release": "node --test scripts/release-candidate-manifest.test.mjs",
    "production:sbom:capture": "node scripts/capture-production-image-bindings.mjs",
    "production:sbom:validate": "node scripts/validate-production-sboms.mjs",
    "lint:production:sbom": "eslint scripts/capture-production-image-bindings.mjs scripts/validate-production-sboms.mjs scripts/production-sboms.test.mjs --config scripts/eslint.config.mjs",
    "test:production:sbom": "node --test scripts/production-sboms.test.mjs",
    "production:preflight": "tsx scripts/production-go-live-preflight.ts",
    "production:preflight:json": "tsx scripts/production-go-live-preflight.ts --json",
    "lint:production:preflight": "eslint scripts/job-envelope-rollout-preflight.ts scripts/job-envelope-rollout-preflight.test.ts scripts/production-deployment-target.ts scripts/production-evidence-bundle.ts scripts/production-evidence-bundle.test.ts scripts/production-go-live-preflight.ts scripts/production-go-live-preflight.test.ts scripts/public-launch-authority-decision.ts scripts/public-launch-authority-decision.test.ts --config scripts/eslint.config.mjs",
    "typecheck:production:preflight": "tsc --noEmit -p tsconfig.production-preflight.json",
    "test:production:preflight": "tsx --test scripts/job-envelope-rollout-preflight.test.ts scripts/production-evidence-bundle.test.ts scripts/production-go-live-preflight.test.ts scripts/public-launch-authority-decision.test.ts",
    "build": "npm run build --workspaces --if-present",
    "lint:production:artifacts": "eslint \"infra/containers/*.mjs\" infra/aws/validate-account-guardrails.mjs infra/aws/validate-account-guardrails.test.mjs infra/aws/validate-application-observability.mjs infra/aws/validate-application-observability.test.mjs infra/aws/validate-fixed-slot-credential-transition.mjs infra/aws/validate-fixed-slot-credential-transition.test.mjs infra/egress/validate-egress-policy.mjs infra/egress/validate-egress-policy.test.mjs infra/providers/validate-kan-62-provider-decision.mjs infra/providers/validate-kan-62-provider-decision.test.mjs infra/providers/validate-active-provider-research-captures.mjs infra/providers/validate-active-provider-research-captures.test.mjs infra/providers/validate-dormant-provider-inventory.mjs infra/providers/validate-dormant-provider-inventory.test.mjs \"infra/security/*.mjs\" infra/shared/parse-strict-json.mjs infra/shared/read-secure-local-file.mjs \"infra/valuation/*.mjs\" --config scripts/eslint.config.mjs --global Buffer --global console --global process --global structuredClone --global TextDecoder --global URL",
    "lint": "npm run lint --workspaces --if-present && npm run lint:production:preflight && npm run lint:release && npm run lint:production:sbom && npm run lint:production:artifacts",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:production:preflight",
    "test": "npm run test --workspaces --if-present && npm run test:production:preflight && npm run test:release && npm run test:production:sbom",
    "test:local-demo": "node --test tools/local-demo/*.test.mjs && npm run demo:local:preflight",
    "test:local-evm": "node --test tools/local-evm/*.test.mjs",
    "test:integration": "npm run test:integration --workspace @crypto-lending/api",
    "infra:validate": "npm run security:scan:secrets && npm run security:validate:threat-model && npm run security:validate:logging-governance && npm run security:validate:wallet-review && npm run security:validate:wallet-penetration-preparation && npm run infra:validate:containers && npm run infra:validate:application && npm run infra:validate:workload-boundaries && npm run infra:validate:observability && npm run infra:validate:credential-transition && npm run infra:validate:migrations && npm run infra:validate:guardrails && npm run infra:validate:acm-dns && npm run infra:validate:sqs && npm run infra:validate:redis-acl && npm run infra:validate:egress && npm run infra:validate:providers && npm run infra:validate:valuation",
    "infra:validate:containers": "node infra/containers/validate-production-containers.mjs",
    "infra:validate:application": "node infra/aws/validate-application-baseline.mjs",
    "infra:validate:workload-boundaries": "node infra/aws/validate-application-workload-boundaries.mjs",
    "infra:validate:observability": "node infra/aws/validate-application-observability.mjs",
    "infra:validate:credential-transition": "node infra/aws/validate-fixed-slot-credential-transition.mjs",
    "infra:validate:migrations": "node infra/aws/validate-database-migration-task.mjs",
    "infra:validate:guardrails": "node infra/aws/validate-account-guardrails.mjs && node infra/aws/validate-billing-control-record.mjs --record infra/aws/billing-control-record.example.json --mode example",
    "infra:validate:acm-dns": "node infra/aws/validate-acm-dns-control-record.mjs --record infra/aws/acm-dns-control-record.example.json --mode example",
    "infra:validate:sqs": "node infra/aws/validate-sqs-foundation.mjs",
    "infra:validate:redis-acl": "node infra/redis/validate-redis-acl.mjs",
    "infra:validate:egress": "node infra/egress/validate-egress-policy.mjs --policy infra/egress/egress-policy.example.json --mode example",
    "infra:validate:providers": "node infra/providers/validate-kan-62-provider-decision.mjs && node infra/providers/validate-active-provider-research-captures.mjs && node infra/providers/validate-dormant-provider-inventory.mjs",
    "infra:validate:valuation": "node infra/valuation/validate-kan-66-stablecoin-valuation-decision.mjs",
    "infra:test:guardrails": "node --test infra/aws/validate-account-guardrails.test.mjs infra/aws/validate-billing-control-record.test.mjs",
    "infra:test:containers": "node --test infra/containers/validate-built-runtime.test.mjs infra/containers/validate-production-containers.test.mjs",
    "infra:test:acm-dns": "node --test infra/aws/validate-acm-dns-control-record.test.mjs",
    "infra:test:migrations": "node --test infra/aws/validate-database-migration-task.test.mjs",
    "infra:test:workload-boundaries": "node --test infra/aws/validate-application-workload-boundaries.test.mjs",
    "infra:test:observability": "node --test infra/aws/validate-application-observability.test.mjs",
    "infra:test:credential-transition": "node --test infra/aws/validate-fixed-slot-credential-transition.test.mjs",
    "infra:test:sqs": "node --test infra/aws/validate-sqs-foundation.test.mjs",
    "infra:test:redis-acl": "node --test infra/redis/validate-redis-acl.test.mjs",
    "infra:test:egress": "node --test infra/egress/validate-egress-policy.test.mjs infra/egress/validate-no-cloud-ci.test.mjs infra/aws/validate-application-baseline.test.mjs",
    "infra:test:providers": "node --test infra/providers/validate-kan-62-provider-decision.test.mjs infra/providers/validate-active-provider-research-captures.test.mjs infra/providers/validate-dormant-provider-inventory.test.mjs",
    "infra:test:valuation": "node --test infra/valuation/validate-kan-66-stablecoin-valuation-decision.test.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:scan:secrets": "node infra/security/validate-repository-secrets.mjs",
    "security:test:jira": "node scripts/run-jira-http-security-test.mjs",
    "security:test:secrets": "node --test infra/security/validate-repository-secrets.test.mjs",
    "security:test:threat-model": "node --test infra/security/validate-kan-49-threat-model.test.mjs",
    "security:test:logging-governance": "node --test infra/security/validate-kan-248-logging-governance.test.mjs",
    "security:test:wallet-review": "node --test infra/security/validate-kan-227-wallet-review.test.mjs",
    "security:test:wallet-penetration-preparation": "node --test infra/security/validate-kan-235-wallet-penetration-test-preparation.test.mjs",
    "security:validate:threat-model": "node infra/security/validate-kan-49-threat-model.mjs",
    "security:validate:logging-governance": "node infra/security/validate-kan-248-logging-governance.mjs",
    "security:validate:wallet-review": "node infra/security/validate-kan-227-wallet-review.mjs",
    "security:validate:wallet-penetration-preparation": "node infra/security/validate-kan-235-wallet-penetration-test-preparation.mjs",
    "openapi:generate": "npm run openapi:generate --workspace @crypto-lending/api",
    "db:migrate": "npm run db:migrate --workspace @crypto-lending/api",
    "db:rollback": "npm run db:rollback --workspace @crypto-lending/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "hardhat": "3.14.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "scarfSettings": {
    "enabled": false
  }
}

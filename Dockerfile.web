ARG OCI_SOURCE=
ARG OCI_REVISION=0000000000000000000000000000000000000000
ARG OCI_CREATED=1970-01-01T00:00:00Z
ARG SOURCE_DATE_EPOCH=0

FROM node:26.8-bookworm-slim@sha256:cd9f682fa2885cd1056e830424764158570061c59736a1da836bc3d73df095ae AS metadata

ARG OCI_SOURCE
ARG OCI_REVISION
ARG OCI_CREATED
ARG SOURCE_DATE_EPOCH
ENV OCI_SOURCE=${OCI_SOURCE} \
    OCI_REVISION=${OCI_REVISION} \
    OCI_CREATED=${OCI_CREATED} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

WORKDIR /metadata
COPY infra/containers/validate-oci-build-metadata.mjs ./infra/containers/validate-oci-build-metadata.mjs
RUN ["node", "infra/containers/validate-oci-build-metadata.mjs"]
RUN ["node", "-e", "require('node:fs').writeFileSync('/oci-metadata.validated','validated\\n',{encoding:'utf8',flag:'wx',mode:0o444})"]

FROM node:26.8-bookworm-slim@sha256:cd9f682fa2885cd1056e830424764158570061c59736a1da836bc3d73df095ae AS build

ENV NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_IGNORE_SCRIPTS=true \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /workspace
RUN ["npm", "install", "--global", "npm@11.6.4"]
RUN ["node", "-e", "if (require('node:child_process').execFileSync('npm', ['--version'], { encoding: 'utf8' }).trim() !== '11.6.4') process.exit(1)"]

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN ["npm", "ci", "--workspace", "@crypto-lending/web", "--include-workspace-root=false"]

COPY apps/web/next-env.d.ts apps/web/next.config.ts apps/web/tsconfig.json apps/web/instrumentation.ts apps/web/proxy.ts ./apps/web/
COPY apps/web/app ./apps/web/app
COPY apps/web/components ./apps/web/components
COPY apps/web/lib ./apps/web/lib
ENV NODE_ENV=production
RUN ["npm", "run", "build", "--workspace", "@crypto-lending/web"]
RUN ["node", "-e", "const fs=require('node:fs');const file='apps/web/.next/standalone/apps/web/package.json';const current=JSON.parse(fs.readFileSync(file,'utf8'));fs.writeFileSync(file,JSON.stringify({name:current.name,private:true,version:current.version})+'\\n',{encoding:'utf8',flag:'w'});"]
COPY infra/containers/validate-built-runtime.mjs ./infra/containers/validate-built-runtime.mjs
RUN ["node", "infra/containers/validate-built-runtime.mjs", "web", "apps/web/.next/standalone"]

FROM node:26.8-bookworm-slim@sha256:cd9f682fa2885cd1056e830424764158570061c59736a1da836bc3d73df095ae AS runtime

ARG OCI_SOURCE
ARG OCI_REVISION
ARG OCI_CREATED
LABEL org.opencontainers.image.base.digest="sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e" \
      org.opencontainers.image.base.name="docker.io/library/node:24.20.0-bookworm-slim" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="Crypto Lending Next.js web runtime" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.title="crypto-lending-web"

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    HOME=/tmp \
    TMPDIR=/tmp

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin app \
    && mkdir -p /app/apps/web \
    && chown -R 10001:10001 /app \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=build --chown=10001:10001 /workspace/apps/web/.next/standalone /app
COPY --from=build --chown=10001:10001 /workspace/apps/web/.next/static /app/apps/web/.next/static
COPY --from=metadata --chown=0:0 /oci-metadata.validated /usr/share/crypto-lending/oci-metadata.validated
WORKDIR /app/apps/web

USER 10001:10001
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["node", "-e", "require('node:http').get('http://127.0.0.1:3000/api/health',r=>{r.resume();process.exitCode=r.statusCode===200?0:1}).on('error',()=>process.exit(1))"]
ENTRYPOINT []
CMD ["node", "server.js"]

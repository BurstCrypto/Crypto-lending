# Root-context application builds use an allowlist. This prevents ignored local
# credentials, repository metadata, developer dependencies, and prior outputs
# from being transferred to either a local or remote Docker builder.
*

!.dockerignore
!package.json
!package-lock.json
!tsconfig.base.json

!apps/
!apps/api/
!apps/api/Dockerfile
!apps/api/package.json
!apps/api/nest-cli.json
!apps/api/tsconfig.json
!apps/api/tsconfig.build.json
!apps/api/src/
!apps/api/src/**

!apps/web/
!apps/web/Dockerfile
!apps/web/package.json
!apps/web/next.config.ts
!apps/web/next-env.d.ts
!apps/web/proxy.ts
!apps/web/tsconfig.json
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/lib/
!apps/web/lib/**
!apps/web/public/
!apps/web/public/**

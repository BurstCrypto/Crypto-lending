            "Value": "crypto-lending"
          },
          {
            "Key": "environment",
            "Value": "production"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-WorkloadRouteTableA"
            }
          }
        ]
      }
    },
    "WorkloadRouteAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "ProvisionNetwork",
      "Properties": {
        "SubnetId": {

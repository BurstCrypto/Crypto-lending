{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Production network foundation: isolated IPv4 subnets and dedicated workload security groups. Disabled by default; provisioning this foundation does not activate an application or authorize public launch.",
  "Metadata": {
    "CryptoLendingProductionNetworkFoundation": {
      "SchemaVersion": 1,
      "Environment": "production",
      "Scope": "NETWORK_FOUNDATION_ONLY",
      "DefaultResourceCount": 0,
      "PublicIngress": "ABSENT",
      "InternetRoute": "ABSENT",
      "LaunchApproval": "NOT_APPROVED"
    }
  },
  "Parameters": {
    "ActivationMode": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": ["DISABLED", "PROVISION_INERT"]
    },
    "BillingAcknowledgement": {
      "Type": "String",
      "Default": "NOT_AUTHORIZED",
      "AllowedValues": ["NOT_AUTHORIZED", "I_ACKNOWLEDGE_THIS_CREATES_BILLABLE_AWS_RESOURCES"]
    },
    "NetworkOctet": {
      "Type": "String",
      "Default": "43",
      "AllowedPattern": "^(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
      "Description": "Second octet of the private 10.x.0.0/16 network; confirm no overlap with existing or planned networks."
    },
    "AvailabilityZoneA": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "First approved Availability Zone in the deployment Region."
    },
    "AvailabilityZoneB": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "Second approved Availability Zone in the deployment Region."
    }
  },
  "Rules": {
    "ProvisioningRequiresAcknowledgement": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "ActivationMode"
          },
          "PROVISION_INERT"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "BillingAcknowledgement"
              },
              "I_ACKNOWLEDGE_THIS_CREATES_BILLABLE_AWS_RESOURCES"
            ]
          },
          "AssertDescription": "Explicit resource provisioning acknowledgement is required; this parameter does not replace deployment authorization."
        }
      ]
    },
    "AvailabilityZonesMustDiffer": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "ActivationMode"
          },
          "PROVISION_INERT"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "AvailabilityZoneA"
                  },
                  {
                    "Ref": "AvailabilityZoneB"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Use two distinct Availability Zones in the deployment Region."
        }
      ]
    }
  },
  "Conditions": {
    "ProvisionNetwork": {
      "Fn::Equals": [
        {
          "Ref": "ActivationMode"
        },
        "PROVISION_INERT"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Condition": "ProvisionNetwork",
      "Properties": {
        "CidrBlock": {
          "Fn::Sub": "10.${NetworkOctet}.0.0/16"
        },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "InstanceTenancy": "default",
        "Tags": [
          {
            "Key": "project",
            "Value": "crypto-lending"
          },
          {
            "Key": "environment",
            "Value": "production"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-Vpc"
            }
          }
        ]
      }
    },
    "WorkloadSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "ProvisionNetwork",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZoneA"
        },
        "CidrBlock": {
          "Fn::Sub": "10.${NetworkOctet}.10.0/24"
        },
        "MapPublicIpOnLaunch": false,
        "AssignIpv6AddressOnCreation": false,
        "EnableDns64": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "crypto-lending"
          },
          {
            "Key": "environment",
            "Value": "production"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-WorkloadSubnetA"
            }
          }
        ]
      }
    },
    "WorkloadRouteTableA": {
      "Type": "AWS::EC2::RouteTable",
      "Condition": "ProvisionNetwork",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },

# This harness is intentionally localhost/testnet-only. The project ID is a
# public client identifier; never place a secret, private key, or seed here.
VITE_WALLET_LAB_ENABLED=false
# Set this to the exact frozen 40-character commit before collecting evidence.
VITE_WALLET_LAB_CANDIDATE_COMMIT=
# Setting this literal flag means the two authorized evaluators have reviewed
# and accept the installed WalletConnect/Reown terms for this local test only.
VITE_WALLETCONNECT_TERMS_ACCEPTED=false
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
